---
import Search from "astro-pagefind/components/Search.astro";

interface Props {
  title?: string;
}

const { title = "Awesome Coding Plans" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script defer src="https://analytics.netlify.com/ns.js"></script>
  </head>
  <body>
    <div class="layout">
      <sidebar class="sidebar">
        <div class="sidebar-header">
          <a href="/" class="logo">Awesome Coding Plans</a>
        </div>
        <div class="search-container">
          <Search />
        </div>
        <nav class="nav">
          <slot name="sidebar" />
        </nav>
      </sidebar>
      <main class="content">
        <slot />
      </main>
    </div>
  </body>
</html>

<style is:global>
  :root {
    --bg: #ffffff;
    --bg-sidebar: #f8f9fa;
    --text: #1a1a1a;
    --text-muted: #6b7280;
    --border: #e5e7eb;
    --accent: #2563eb;
    --accent-light: #dbeafe;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0f172a;
      --bg-sidebar: #1e293b;
      --text: #f1f5f9;
      --text-muted: #94a3b8;
      --border: #334155;
      --accent: #60a5fa;
      --accent-light: #1e3a5f;
    }
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
  }

  .layout {
    display: flex;
    min-height: 100vh;
  }

  .sidebar {
    width: 280px;
    background: var(--bg-sidebar);
    border-right: 1px solid var(--border);
    padding: 1.5rem;
    position: fixed;
    height: 100vh;
    overflow-y: auto;
  }

  .sidebar-header {
    margin-bottom: 1.5rem;
  }

  .logo {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
  }

  .search-container {
    margin-bottom: 1.5rem;
  }

  .nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav a {
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    font-size: 0.875rem;
  }

  .nav a:hover,
  .nav a.active {
    background: var(--accent-light);
    color: var(--accent);
  }

  .nav .section-title {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 1rem;
    margin-bottom: 0.25rem;
    padding-left: 0.75rem;
  }

  .content {
    margin-left: 280px;
    padding: 2rem 3rem;
    max-width: 900px;
  }

  h1 {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  h2 {
    font-size: 1.5rem;
    margin: 2rem 0 1rem;
  }

  h3 {
    font-size: 1.2rem;
    margin: 1.5rem 0 0.75rem;
  }

  p {
    margin-bottom: 1rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0;
    font-size: 0.875rem;
  }

  th,
  td {
    padding: 0.6rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
  }

  th {
    font-weight: 600;
    background: var(--bg-sidebar);
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  code {
    background: var(--bg-sidebar);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.85em;
  }

  blockquote {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    margin: 1rem 0;
    color: var(--text-muted);
  }

  ul,
  ol {
    margin: 0.5rem 0 1rem 1.5rem;
  }

  li {
    margin-bottom: 0.25rem;
  }

  @media (max-width: 768px) {
    .sidebar {
      display: none;
    }
    .content {
      margin-left: 0;
      padding: 1.5rem;
    }
  }
</style>
