---

interface Props {
  title?: string;
  description?: string;
}

const { title = "Awesome Coding Plans", description = "Compare AI coding plans by price, models, quota, tools, and student discounts." } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://awesome-coding-plans.netlify.app${currentPath}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://awesome-coding-plans.netlify.app${currentPath}`} />
    <meta property="og:image" content="https://awesome-coding-plans.netlify.app/favicon.svg" />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script defer src="https://analytics.netlify.com/ns.js"></script>
    <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "WebSite", name: "Awesome Coding Plans", url: "https://awesome-coding-plans.netlify.app", description })}></script>
  </head>
  <body>
    <div class="app">
      <header class="topbar">
        <a href="/" class="brand"><span class="brand-prompt">&gt;_</span><span>CodingPlans</span></a>
        <nav class="topnav" aria-label="Primary navigation">
          <a href="/" class={currentPath === "/" ? "active" : ""}>Catalog</a>
          <a href="/comparison" class={currentPath.startsWith("/comparison") ? "active" : ""}>Compare</a>
          <a href="/student-discounts" class={currentPath.startsWith("/student-discounts") ? "active" : ""}>Students</a>
          <a href="/faq" class={currentPath.startsWith("/faq") ? "active" : ""}>FAQ</a>
        </nav>
        <div class="nav-meta"><span><i></i> 30 plans</span><a href="/plans.json">JSON</a><a class="source-link" href="https://github.com/vaproh/awesome-coding-plans">GitHub ↗</a></div>
      </header>
      <main class="main">
        <slot />
      </main>
      <footer class="site-footer"><span>Awesome Coding Plans · verified September 3, 2026</span><span><a href="/llms.txt">For agents</a> · <a href="https://github.com/vaproh/awesome-coding-plans">Source</a></span></footer>
    </div>

    <script>
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add("is-visible")), { threshold: 0.08 });
      document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
      document.querySelectorAll("[data-count]").forEach((element) => {
        const target = Number(element.getAttribute("data-count"));
        const update = () => { element.textContent = String(Math.min(target, Math.ceil(Number(element.textContent || 0) + target / 12))); if (Number(element.textContent) < target) requestAnimationFrame(update); };
        element.textContent = "0";
        update();
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #111111;
    --bg-elevated: #181818;
    --bg-card: #1e1e1e;
    --bg-card-hover: #292929;
    --border: #383838;
    --border-light: #505050;
    --text: #eeeeee;
    --text-muted: #b5b5b5;
    --text-dim: #777777;
    --accent: #bdbdbd;
    --accent-light: #f5f5f5;
    --accent-glow: rgba(189, 189, 189, 0.16);
    --free: #aaaaaa;
    --free-glow: rgba(170, 170, 170, 0.14);
    --orange: #999999;
    --orange-glow: rgba(153, 153, 153, 0.15);
    --red: #c2c2c2;
    --radius: 12px;
    --radius-sm: 8px;
    --radius-lg: 16px;
    --shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
    --shadow-lg: 0 8px 48px rgba(0, 0, 0, 0.4);
    --transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: "Space Grotesk", sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .app {
    display: block;
    min-height: 100vh;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    min-height: 68px;
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 0 4vw;
    background: rgba(17, 17, 17, 0.94);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(14px);
  }
  .brand { display: flex; align-items: center; gap: .55rem; color: var(--text); font-weight: 700; text-decoration: none; white-space: nowrap; }
  .brand-prompt { color: var(--accent); font-family: "DM Mono", monospace; font-size: 1.25rem; }
  .topnav { display: flex; gap: .3rem; flex: 1; }
  .topnav a { padding: .45rem .7rem; color: var(--text-muted); text-decoration: none; border-bottom: 1px solid transparent; font-size: .85rem; }
  .topnav a:hover, .topnav a.active { color: var(--accent-light); border-color: var(--accent); }
  .nav-meta { display:flex; align-items:center; gap:1rem; color:var(--text-dim); font:500 .68rem "DM Mono",monospace; white-space:nowrap; }
  .nav-meta a { color:var(--text-muted); text-decoration:none; }
  .nav-meta a:hover { color:var(--accent); }
  .nav-meta i { display:inline-block; width:6px; height:6px; margin-right:.25rem; border-radius:50%; background:var(--free); }
  /* Main content */
  .main {
    width: min(1240px, 92vw);
    margin: 0 auto;
    padding: 2.5rem 0 5rem;
  }
  .site-footer { width: min(1240px, 92vw); margin: auto; padding: 1.5rem 0 2.5rem; display: flex; justify-content: space-between; gap: 1rem; border-top: 1px solid var(--border); color: var(--text-dim); font-size: .75rem; }
  .site-footer a { color: var(--text-muted); }

  /* Animations */
  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideInLeft {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes glow {
    0%, 100% { box-shadow: 0 0 20px var(--accent-glow); }
    50% { box-shadow: 0 0 40px var(--accent-glow); }
  }

  /* Stagger animation for cards */
  .stagger > * { animation: fadeInUp 0.4s ease-out both; }
  .reveal { opacity: 0; transform: translateY(14px); transition: opacity .55s ease, transform .55s ease; }
  .reveal.is-visible { opacity: 1; transform: none; }
  .stagger > *:nth-child(1) { animation-delay: 0.02s; }
  .stagger > *:nth-child(2) { animation-delay: 0.04s; }
  .stagger > *:nth-child(3) { animation-delay: 0.06s; }
  .stagger > *:nth-child(4) { animation-delay: 0.08s; }
  .stagger > *:nth-child(5) { animation-delay: 0.1s; }
  .stagger > *:nth-child(6) { animation-delay: 0.12s; }
  .stagger > *:nth-child(7) { animation-delay: 0.14s; }
  .stagger > *:nth-child(8) { animation-delay: 0.16s; }
  .stagger > *:nth-child(9) { animation-delay: 0.18s; }
  .stagger > *:nth-child(10) { animation-delay: 0.2s; }

  /* Typography */
  h1 {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
    line-height: 1.1;
  }

  h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 2.5rem 0 1rem;
    letter-spacing: -0.02em;
  }

  h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 1.5rem 0 0.75rem;
  }

  p {
    margin-bottom: 1rem;
    color: var(--text-muted);
  }

  a {
    color: var(--accent-light);
    text-decoration: none;
    transition: color var(--transition);
  }

  a:hover {
    color: var(--accent);
  }

  /* Tables */
  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin: 1rem 0;
    font-size: 0.85rem;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  th, td {
    padding: 0.75rem 1rem;
    text-align: left;
  }

  th {
    font-weight: 600;
    background: var(--bg-card);
    color: var(--text-muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--border);
  }

  td {
    border-bottom: 1px solid var(--border);
    transition: background var(--transition);
  }

  tr:last-child td {
    border-bottom: none;
  }

  tbody tr:hover td {
    background: var(--bg-card);
  }

  /* Cards */
  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition: all var(--transition);
  }

  .card:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-light);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }

  /* Badges */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .badge-free {
    background: var(--free-glow);
    color: var(--free);
  }

  .badge-paid {
    background: var(--accent-glow);
    color: var(--accent-light);
  }
  .badge-freemium { background: var(--orange-glow); color: var(--orange); }

  .badge-discontinued {
    background: rgba(194, 194, 194, 0.15);
    color: var(--red);
  }

  /* Hero */
  .hero {
    padding: 2rem 0 3rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
    animation: fadeIn 0.6s ease-out;
  }

  .hero h1 {
    background: linear-gradient(135deg, var(--text) 0%, var(--accent-light) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-stats {
    display: flex;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .stat {
    text-align: center;
  }

  .stat-value {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--accent-light);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .topbar { gap: 1rem; padding: 0 4vw; flex-wrap: wrap; padding-top: .7rem; padding-bottom: .7rem; }
    .topnav { order: 3; flex-basis: 100%; }
    .nav-meta { margin-left:auto; }
    .main { padding: 1.5rem 0 4rem; }
    .site-footer { flex-direction: column; }
    h1 { font-size: 1.75rem; }
    .card-grid {
      grid-template-columns: 1fr;
    }
    .hero-stats {
      flex-wrap: wrap;
      gap: 1rem;
    }
  }

</style>
