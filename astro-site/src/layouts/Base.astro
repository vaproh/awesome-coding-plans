---
import Search from "astro-pagefind/components/Search.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Awesome Coding Plans", description = "Compare AI coding plans by price, models, quota, tools, and student discounts." } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`https://awesome-coding-plans.netlify.app${currentPath}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={`https://awesome-coding-plans.netlify.app${currentPath}`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script defer src="https://analytics.netlify.com/ns.js"></script>
    <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "WebSite", name: "Awesome Coding Plans", url: "https://awesome-coding-plans.netlify.app", description })}></script>
  </head>
  <body>
    <div class="app">
      <header class="topbar">
        <a href="/" class="brand"><span class="brand-prompt">&gt;_</span><span>CodingPlans</span></a>
        <nav class="topnav" aria-label="Primary navigation">
          <a href="/" class={currentPath === "/" ? "active" : ""}>Catalog</a>
          <a href="/comparison" class={currentPath.startsWith("/comparison") ? "active" : ""}>Compare</a>
          <a href="/student-discounts" class={currentPath.startsWith("/student-discounts") ? "active" : ""}>Students</a>
        </nav>
        <div class="top-search"><Search /></div>
      </header>
      <main class="main">
        <slot />
      </main>
    </div>

    <script>
      const observer = new IntersectionObserver((entries) => entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add("is-visible")), { threshold: 0.08 });
      document.querySelectorAll(".reveal").forEach((element) => observer.observe(element));
      document.querySelectorAll("[data-count]").forEach((element) => {
        const target = Number(element.getAttribute("data-count"));
        const update = () => { element.textContent = String(Math.min(target, Math.ceil(Number(element.textContent || 0) + target / 12))); if (Number(element.textContent) < target) requestAnimationFrame(update); };
        element.textContent = "0";
        update();
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #07100d;
    --bg-elevated: #0b1712;
    --bg-card: #0e1d16;
    --bg-card-hover: #13291e;
    --border: #1c3a29;
    --border-light: #2b573b;
    --text: #e4f5e8;
    --text-muted: #8dad96;
    --text-dim: #557160;
    --accent: #4ade80;
    --accent-light: #86efac;
    --accent-glow: rgba(74, 222, 128, 0.14);
    --green: #22c55e;
    --green-glow: rgba(34, 197, 94, 0.15);
    --orange: #f59e0b;
    --orange-glow: rgba(245, 158, 11, 0.15);
    --red: #ef4444;
    --purple: #a855f7;
    --purple-glow: rgba(168, 85, 247, 0.15);
    --radius: 12px;
    --radius-sm: 8px;
    --radius-lg: 16px;
    --shadow: 0 4px 24px rgba(0, 0, 0, 0.3);
    --shadow-lg: 0 8px 48px rgba(0, 0, 0, 0.4);
    --transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    --transition-slow: 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: "Space Grotesk", sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .app {
    display: flex;
    min-height: 100vh;
  }

  .topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    min-height: 68px;
    display: flex;
    align-items: center;
    gap: 2rem;
    padding: 0 4vw;
    background: rgba(7, 16, 13, 0.92);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(14px);
  }
  .brand { display: flex; align-items: center; gap: .55rem; color: var(--text); font-weight: 700; text-decoration: none; white-space: nowrap; }
  .brand-prompt { color: var(--accent); font-family: "DM Mono", monospace; font-size: 1.25rem; }
  .topnav { display: flex; gap: .3rem; flex: 1; }
  .topnav a { padding: .45rem .7rem; color: var(--text-muted); text-decoration: none; border-bottom: 1px solid transparent; font-size: .85rem; }
  .topnav a:hover, .topnav a.active { color: var(--accent-light); border-color: var(--accent); }
  .top-search { width: min(280px, 30vw); }
  .sidebar {
    display: none;
    width: 280px;
    background: var(--bg-elevated);
    border-right: 1px solid var(--border);
    padding: 1.5rem 1rem;
    position: fixed;
    height: 100vh;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    z-index: 100;
    transition: transform var(--transition-slow);
  }

  .search-wrap {
    margin-bottom: 1.5rem;
  }

  .sidenav {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    flex: 1;
  }

  .sidenav a {
    color: var(--text-muted);
    text-decoration: none;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 500;
    transition: all var(--transition);
    border: 1px solid transparent;
  }

  .sidenav a:hover {
    background: var(--bg-card);
    color: var(--text);
    border-color: var(--border);
  }

  .sidenav a.active {
    background: var(--accent-glow);
    color: var(--accent-light);
    border-color: var(--accent);
  }

  .sidenav .section-title {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    margin-top: 1.25rem;
    margin-bottom: 0.35rem;
    padding-left: 0.75rem;
  }

  .sidebar-footer {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-size: 0.7rem;
    color: var(--text-dim);
  }

  /* Main content */
  .main {
    flex: 1;
    width: min(1240px, 92vw);
    margin: 0 auto;
    padding: 2.5rem 0 5rem;
  }

  /* Animations */
  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideInLeft {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  @keyframes glow {
    0%, 100% { box-shadow: 0 0 20px var(--accent-glow); }
    50% { box-shadow: 0 0 40px var(--accent-glow); }
  }

  /* Stagger animation for cards */
  .stagger > * { animation: fadeInUp 0.4s ease-out both; }
  .reveal { opacity: 0; transform: translateY(14px); transition: opacity .55s ease, transform .55s ease; }
  .reveal.is-visible { opacity: 1; transform: none; }
  .stagger > *:nth-child(1) { animation-delay: 0.02s; }
  .stagger > *:nth-child(2) { animation-delay: 0.04s; }
  .stagger > *:nth-child(3) { animation-delay: 0.06s; }
  .stagger > *:nth-child(4) { animation-delay: 0.08s; }
  .stagger > *:nth-child(5) { animation-delay: 0.1s; }
  .stagger > *:nth-child(6) { animation-delay: 0.12s; }
  .stagger > *:nth-child(7) { animation-delay: 0.14s; }
  .stagger > *:nth-child(8) { animation-delay: 0.16s; }
  .stagger > *:nth-child(9) { animation-delay: 0.18s; }
  .stagger > *:nth-child(10) { animation-delay: 0.2s; }

  /* Typography */
  h1 {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 0.75rem;
    line-height: 1.1;
  }

  h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 2.5rem 0 1rem;
    letter-spacing: -0.02em;
  }

  h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 1.5rem 0 0.75rem;
  }

  p {
    margin-bottom: 1rem;
    color: var(--text-muted);
  }

  a {
    color: var(--accent-light);
    text-decoration: none;
    transition: color var(--transition);
  }

  a:hover {
    color: var(--accent);
  }

  /* Tables */
  table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin: 1rem 0;
    font-size: 0.85rem;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  th, td {
    padding: 0.75rem 1rem;
    text-align: left;
  }

  th {
    font-weight: 600;
    background: var(--bg-card);
    color: var(--text-muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--border);
  }

  td {
    border-bottom: 1px solid var(--border);
    transition: background var(--transition);
  }

  tr:last-child td {
    border-bottom: none;
  }

  tbody tr:hover td {
    background: var(--bg-card);
  }

  /* Cards */
  .card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
    transition: all var(--transition);
  }

  .card:hover {
    background: var(--bg-card-hover);
    border-color: var(--border-light);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
    margin: 1.5rem 0;
  }

  /* Badges */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .badge-free {
    background: var(--green-glow);
    color: var(--green);
  }

  .badge-paid {
    background: var(--accent-glow);
    color: var(--accent-light);
  }
  .badge-freemium { background: var(--orange-glow); color: var(--orange); }

  .badge-discontinued {
    background: rgba(239, 68, 68, 0.15);
    color: var(--red);
  }

  /* Hero */
  .hero {
    padding: 2rem 0 3rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
    animation: fadeIn 0.6s ease-out;
  }

  .hero h1 {
    background: linear-gradient(135deg, var(--text) 0%, var(--accent-light) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-stats {
    display: flex;
    gap: 2rem;
    margin-top: 1.5rem;
  }

  .stat {
    text-align: center;
  }

  .stat-value {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--accent-light);
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .topbar { gap: 1rem; padding: 0 4vw; flex-wrap: wrap; padding-top: .7rem; padding-bottom: .7rem; }
    .topnav { order: 3; flex-basis: 100%; }
    .top-search { margin-left: auto; width: min(190px, 42vw); }
    .main { padding: 1.5rem 0 4rem; }
    h1 { font-size: 1.75rem; }
    .card-grid {
      grid-template-columns: 1fr;
    }
    .hero-stats {
      flex-wrap: wrap;
      gap: 1rem;
    }
  }

  /* Pagefind overrides */
  .pagefind-ui__search-input {
    background: var(--bg-card) !important;
    border: 1px solid var(--border) !important;
    border-radius: var(--radius-sm) !important;
    color: var(--text) !important;
    padding: 0.6rem 0.75rem !important;
  }

  .pagefind-ui__search-input:focus {
    border-color: var(--accent) !important;
    outline: none !important;
  }

  .pagefind-ui__results {
    background: var(--bg-card) !important;
    border: 1px solid var(--border) !important;
    border-radius: var(--radius) !important;
  }

  .pagefind-ui__result-title {
    color: var(--text) !important;
  }

  .pagefind-ui__result-excerpt {
    color: var(--text-muted) !important;
  }
</style>
