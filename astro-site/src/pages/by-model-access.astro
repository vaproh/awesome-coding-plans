---
import Base from "../layouts/Base.astro";
import PlanTable from "../components/PlanTable.astro";
import { getCollection } from "astro:content";

const plans = await getCollection("plans");
const order = ["Single", "Multi-model", "Aggregator", "Frontier"];
const labels: Record<string, string> = { Single: "Single model", "Multi-model": "Multi-model", Aggregator: "Aggregator", Frontier: "Frontier only" };
const groups = order
  .map((access) => ({ access, plans: plans.filter((plan) => plan.data.modelAccess === access).sort((a, b) => a.data.title.localeCompare(b.data.title)) }))
  .filter((group) => group.plans.length > 0);
---

<Base title="Browse AI coding plans by model access | Awesome Coding Plans" description="AI coding plans grouped by model access: single-model, multi-model, aggregator, and frontier-only offerings.">
  <section class="browse reveal">
    <p class="eyebrow">browse / model access</p>
    <h1>By <span>model access.</span></h1>
    <p class="lede">Single-model plans bet on one family. Multi-model plans switch models per task. Aggregators resell many providers. Frontier plans carry one lab's flagship lineup.</p>
    {groups.map((group) => (
      <section>
        <h2>{labels[group.access]}</h2>
        <PlanTable plans={group.plans} />
      </section>
    ))}
  </section>
</Base>

<style>
  .browse { max-width: 900px; padding: 4rem 0 2rem; }
  .eyebrow { color: var(--accent); font: 500 .72rem "DM Mono", monospace; letter-spacing: .08em; text-transform: uppercase; margin: 0 0 1rem; }
  h1 { font-size: clamp(3rem, 8vw, 6rem); line-height: .95; letter-spacing: -.07em; margin: 0 0 1.5rem; }
  h1 span { color: var(--accent); }
  .lede { font-size: 1.05rem; max-width: 640px; margin-bottom: 2.5rem; }
  section section { margin-bottom: 3rem; }
  h2 { font-size: 1.4rem; margin: 0 0 1rem; }
  @media (max-width: 650px) { table { display: block; overflow-x: auto; white-space: nowrap; } }
</style>
