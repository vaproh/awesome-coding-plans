---
import Base from "../layouts/Base.astro";
import PlanTable from "../components/PlanTable.astro";
import { getCollection } from "astro:content";

const plans = await getCollection("plans");
const order = ["Free", "Budget", "Mid", "Premium", "Enterprise"];
const labels: Record<string, string> = { Free: "Free", Budget: "Budget (under $10)", Mid: "Mid ($10-$20)", Premium: "Premium ($20-$100)", Enterprise: "Enterprise ($100+)" };
const groups = order
  .map((band) => ({ band, plans: plans.filter((plan) => plan.data.priceRange === band).sort((a, b) => a.data.title.localeCompare(b.data.title)) }))
  .filter((group) => group.plans.length > 0);
---

<Base title="Browse AI coding plans by price | Awesome Coding Plans" description="Every AI coding plan in the catalog grouped by monthly price band: free, budget, mid, premium, and enterprise.">
  <section class="browse reveal">
    <p class="eyebrow">browse / price</p>
    <h1>By <span>price band.</span></h1>
    <p class="lede">All {plans.length} plans grouped by the price band of their entry tier. Verify current pricing on each plan's official page before subscribing.</p>
    {groups.map((group) => (
      <section>
        <h2>{labels[group.band]}</h2>
        <PlanTable plans={group.plans} />
      </section>
    ))}
  </section>
</Base>

<style>
  .browse { max-width: 900px; padding: 4rem 0 2rem; }
  .eyebrow { color: var(--accent); font: 500 .72rem "DM Mono", monospace; letter-spacing: .08em; text-transform: uppercase; margin: 0 0 1rem; }
  h1 { font-size: clamp(3rem, 8vw, 6rem); line-height: .95; letter-spacing: -.07em; margin: 0 0 1.5rem; }
  h1 span { color: var(--accent); }
  .lede { font-size: 1.05rem; max-width: 640px; margin-bottom: 2.5rem; }
  section section { margin-bottom: 3rem; }
  h2 { font-size: 1.4rem; margin: 0 0 1rem; }
  @media (max-width: 650px) { table { display: block; overflow-x: auto; white-space: nowrap; } }
</style>
