---
import Base from "../layouts/Base.astro";
import PlanTable from "../components/PlanTable.astro";
import { getCollection } from "astro:content";

const plans = await getCollection("plans");
const tags = ["solo", "team", "student", "enterprise", "agent", "ide", "cli", "api", "byok", "offline", "multimodal", "open-source"];
const groups = tags
  .map((tag) => ({ tag, plans: plans.filter((plan) => [...plan.data.bestForTags, ...plan.data.flags].includes(tag)).sort((a, b) => a.data.title.localeCompare(b.data.title)) }))
  .filter((group) => group.plans.length > 0);
---

<Base title="Browse AI coding plans by tag | Awesome Coding Plans" description="AI coding plans grouped by use case and special flags: solo, team, student, enterprise, agent, IDE, CLI, API, BYOK, offline, and open-source.">
  <section class="browse reveal">
    <p class="eyebrow">browse / tag</p>
    <h1>By <span>tag.</span></h1>
    <p class="lede">Use-case tags and special flags across the whole catalog, from solo hacking to enterprise procurement.</p>
    {groups.map((group) => (
      <section>
        <h2>#{group.tag}</h2>
        <PlanTable plans={group.plans} />
      </section>
    ))}
  </section>
</Base>

<style>
  .browse { max-width: 900px; padding: 4rem 0 2rem; }
  .eyebrow { color: var(--accent); font: 500 .72rem "DM Mono", monospace; letter-spacing: .08em; text-transform: uppercase; margin: 0 0 1rem; }
  h1 { font-size: clamp(3rem, 8vw, 6rem); line-height: .95; letter-spacing: -.07em; margin: 0 0 1.5rem; }
  h1 span { color: var(--accent); }
  .lede { font-size: 1.05rem; max-width: 640px; margin-bottom: 2.5rem; }
  section section { margin-bottom: 3rem; }
  h2 { font-size: 1.4rem; margin: 0 0 1rem; }
  @media (max-width: 650px) { table { display: block; overflow-x: auto; white-space: nowrap; } }
</style>
