---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const plans = await getCollection("plans");
---

<Base title="Compare AI Coding Plans | Awesome Coding Plans" description="Side-by-side comparison of AI coding plans, pricing, quotas, models, and best use cases.">
  <div class="hero">
    <h1>Plan Comparison</h1>
    <p>Side-by-side comparison of the best AI coding plans.</p>
  </div>

  <h2>Best Picks</h2>
  <div class="card-grid stagger">
    <div class="card pick-card">
      <span class="pick-category">Cheapest</span>
      <a href="/plans/chutes/" class="pick-winner">Chutes Base</a>
      <span class="pick-price">$3/mo</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Best Value</span>
      <a href="/plans/opencode-go/" class="pick-winner">OpenCode Go</a>
      <span class="pick-price">$10/mo</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Best Price/Quality</span>
      <a href="/plans/glm-coding-plan/" class="pick-winner">GLM Lite</a>
      <span class="pick-price">$18/mo</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Most Models</span>
      <a href="/plans/github-copilot/" class="pick-winner">GitHub Copilot Pro</a>
      <span class="pick-price">$10/mo</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Best for Open Models</span>
      <a href="/plans/perch-ai/" class="pick-winner">Perch Pro</a>
      <span class="pick-price">$10/mo</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Best for Heavy Use</span>
      <a href="/plans/standard-compute/" class="pick-winner">Standard Compute</a>
      <span class="pick-price">$19/mo</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Best for Students</span>
      <a href="/plans/github-copilot/" class="pick-winner">GitHub Copilot Student</a>
      <span class="pick-price">Free</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Best Free Tier</span>
      <a href="/plans/kimi-code/" class="pick-winner">Kimi Code (Adagio)</a>
      <span class="pick-price">Free</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Best IDE</span>
      <a href="/plans/cursor/" class="pick-winner">Cursor Pro</a>
      <span class="pick-price">$20/mo</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Best Multimodal</span>
      <a href="/plans/minimax-token-plan/" class="pick-winner">MiniMax Plus</a>
      <span class="pick-price">$22/mo</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Best for Privacy</span>
      <a href="/plans/synthetic/" class="pick-winner">Synthetic</a>
      <span class="pick-price">$30/mo</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Best Agent Platform</span>
      <a href="/plans/kimi-code/" class="pick-winner">Kimi Allegro</a>
      <span class="pick-price">¥699/mo</span>
    </div>
  </div>

  <h2>Plans Under $10/Month</h2>
  <table>
    <thead>
      <tr><th>Plan</th><th>Price</th><th>Models</th><th>Quota</th><th>Best For</th></tr>
    </thead>
    <tbody>
      <tr><td><a href="/plans/chutes/">Chutes Base</a></td><td>$3</td><td>13+ open</td><td>5x PAYGO value</td><td>Cheapest sub</td></tr>
      <tr><td><a href="/plans/trae-pro/">Trae Lite</a></td><td>$3</td><td>Multi-model</td><td>$5/mo usage</td><td>AI-native IDE entry</td></tr>
      <tr><td><a href="/plans/mimo-token-plan/">MiMo Lite</a></td><td>$6</td><td>6 MiMo</td><td>4.1B Credits/mo</td><td>No weekly/5h caps</td></tr>
      <tr><td><a href="/plans/qwen-token-plan/">Qwen Lite</a></td><td>~$6</td><td>Qwen3.8, DeepSeek V4</td><td>2,500 Credits/7d</td><td>Multi-model</td></tr>
      <tr><td><a href="/plans/step-plan/">Step Mini</a></td><td>$6.99</td><td>Step 3.7/3.5, audio, image</td><td>400M Credits</td><td>Multimodal</td></tr>
      <tr><td><a href="/plans/cline-pass/">Cline Pass</a></td><td>$9.99</td><td>14 open</td><td>2-5x rate limits</td><td>Cline users</td></tr>
    </tbody>
  </table>

  <h2>Plans $10-$20/Month</h2>
  <table>
    <thead>
      <tr><th>Plan</th><th>Price</th><th>Models</th><th>Quota</th><th>Best For</th></tr>
    </thead>
    <tbody>
      <tr><td><a href="/plans/github-copilot/">GitHub Copilot</a></td><td>$10</td><td>30+ models</td><td>1,500 AI Credits</td><td>Most models</td></tr>
      <tr><td><a href="/plans/perch-ai/">Perch Pro</a></td><td>$10</td><td>15+ models</td><td>Up to $150 usage</td><td>Smart routing</td></tr>
      <tr><td><a href="/plans/opencode-go/">OpenCode Go</a></td><td>$10</td><td>24 models</td><td>$12/5h, $30/wk, $60/mo</td><td>Best value</td></tr>
      <tr><td><a href="/plans/trae-pro/">Trae Pro</a></td><td>$10</td><td>Multi-model</td><td>$20 + Bonus</td><td>SOLO mode</td></tr>
      <tr><td><a href="/plans/nanogpt/">NanoGPT</a></td><td>$12</td><td>4+ flagship</td><td>Weekly limits</td><td>1000+ via PAYGO</td></tr>
      <tr><td><a href="/plans/kimi-code/">Kimi Moderato</a></td><td>~$14</td><td>K3 (256K), K2.7 Code</td><td>60 agent credits</td><td>K3 access</td></tr>
      <tr><td><a href="/plans/mistral-vibe/">Mistral Pro</a></td><td>$14.99</td><td>Medium 3.5, Devstral 2</td><td>100 sessions/day</td><td>European AI</td></tr>
      <tr><td><a href="/plans/kilo-pass/">Kilo Code</a></td><td>Free</td><td>Any model</td><td>Teams $15/mo</td><td>Open-source</td></tr>
      <tr><td><a href="/plans/claude-plans/">Claude Pro</a></td><td>$17-20</td><td>Opus 5, Sonnet 5, Haiku 4.5</td><td>~5x Free</td><td>Frontier quality</td></tr>
      <tr><td><a href="/plans/glm-coding-plan/">GLM Lite</a></td><td>$18</td><td>GLM-5.3, 5.3-Flash</td><td>2K/5h + 10K/wk</td><td>Flagship</td></tr>
      <tr><td><a href="/plans/standard-compute/">Standard Compute</a></td><td>$19</td><td>All frontiers + open</td><td>Flat budget</td><td>No windows</td></tr>
    </tbody>
  </table>
</Base>

<style>
  .pick-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-align: center;
  }

  .pick-category {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dim);
  }

  .pick-winner {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text) !important;
  }

  .pick-winner:hover {
    color: var(--accent-light) !important;
  }

  .pick-price {
    font-size: 0.8rem;
    color: var(--accent-light);
    font-weight: 600;
  }
</style>
