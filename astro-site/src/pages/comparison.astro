---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const plans = (await getCollection("plans")).sort((a, b) => a.data.title.localeCompare(b.data.title));
const bandOrder = ["Free", "Budget", "Mid", "Premium", "Enterprise"];
const bandLabel: Record<string, string> = { Free: "Free", Budget: "Budget (under $10/mo)", Mid: "Mid ($10-$20/mo)", Premium: "Premium ($20-$100/mo)", Enterprise: "Enterprise ($100+/mo)" };
const bands = bandOrder
  .map((band) => ({ band, plans: plans.filter((plan) => plan.data.priceRange === band) }))
  .filter((group) => group.plans.length > 0);
---

<Base title="Compare AI Coding Plans | Awesome Coding Plans" description="Side-by-side comparison of AI coding plans, pricing, quotas, models, and best use cases.">
  <div class="hero">
    <h1>Plan Comparison</h1>
    <p>Side-by-side comparison of the best AI coding plans, generated from the same catalog data that powers <a href="/plans.json">plans.json</a>.</p>
  </div>

  <h2>Best Picks</h2>
  <div class="card-grid stagger">
    <div class="card pick-card">
      <span class="pick-category">Cheapest</span>
      <a href="/plans/chutes/" class="pick-winner">Chutes Base</a>
      <span class="pick-price">$3/mo</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Best Value</span>
      <a href="/plans/opencode-go/" class="pick-winner">OpenCode Go</a>
      <span class="pick-price">$10/mo</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Best Price/Quality</span>
      <a href="/plans/glm-coding-plan/" class="pick-winner">GLM Lite</a>
      <span class="pick-price">$18/mo</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Most Models</span>
      <a href="/plans/github-copilot/" class="pick-winner">GitHub Copilot Pro</a>
      <span class="pick-price">$10/mo</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Best for Open Models</span>
      <a href="/plans/perch-ai/" class="pick-winner">Perch Pro</a>
      <span class="pick-price">$10/mo</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Best for Heavy Use</span>
      <a href="/plans/standard-compute/" class="pick-winner">Standard Compute</a>
      <span class="pick-price">$19/mo</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Best for Students</span>
      <a href="/plans/github-copilot/" class="pick-winner">GitHub Copilot Student</a>
      <span class="pick-price">Free</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Best Free Tier</span>
      <a href="/plans/kimi-code/" class="pick-winner">Kimi Code (Adagio)</a>
      <span class="pick-price">Free</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Best IDE</span>
      <a href="/plans/cursor/" class="pick-winner">Cursor Pro</a>
      <span class="pick-price">$20/mo</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Best Multimodal</span>
      <a href="/plans/minimax-token-plan/" class="pick-winner">MiniMax Plus</a>
      <span class="pick-price">$22/mo</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Best for Privacy</span>
      <a href="/plans/synthetic/" class="pick-winner">Synthetic</a>
      <span class="pick-price">$30/mo</span>
    </div>
    <div class="card pick-card">
      <span class="pick-category">Best Agent Platform</span>
      <a href="/plans/kimi-code/" class="pick-winner">Kimi Allegro</a>
      <span class="pick-price">¥699/mo</span>
    </div>
  </div>

  {bands.map((group) => (
    <section>
      <h2>{bandLabel[group.band]}</h2>
      <table>
        <thead>
          <tr><th>Plan</th><th>Price</th><th>Models</th><th>Quota</th></tr>
        </thead>
        <tbody>
          {group.plans.map((plan) => (
            <tr>
              <td><a href={`/plans/${plan.id}/`}>{plan.data.title}</a></td>
              <td>{plan.data.price}</td>
              <td>{plan.data.models}</td>
              <td>{plan.data.quota}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}
</Base>

<style>
  .pick-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    text-align: center;
  }

  .pick-category {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-dim);
  }

  .pick-winner {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text) !important;
  }

  .pick-winner:hover {
    color: var(--accent-light) !important;
  }

  .pick-price {
    font-size: 0.8rem;
    color: var(--accent-light);
    font-weight: 600;
  }

  @media (max-width: 650px) {
    table { display: block; overflow-x: auto; white-space: nowrap; }
  }
</style>
