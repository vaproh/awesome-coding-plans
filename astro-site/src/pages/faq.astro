---
import Base from "../layouts/Base.astro";

const questions = [
  ["What is included in this catalog?", "AI coding subscriptions, token plans, coding agents, IDEs, APIs, and verified coding-related student offers."],
  ["Are prices guaranteed?", "No. Prices, quotas, models, and availability change. Use each plan's official link to verify details before subscribing."],
  ["What does Freemium mean here?", "The provider has a free tier and one or more paid tiers. Free tier means a usable no-cost option is documented, not unlimited access."],
  ["How should I compare quota?", "Check both the displayed quota model and the plan page. Credits, tokens, requests, sessions, and rolling windows are not directly interchangeable."],
  ["Can agents consume this data?", "Yes. Use /plans.json for structured fields and /llms.txt for crawler guidance. The GitHub repository remains the canonical source."],
  ["How often is the catalog updated?", "The page shows its last verification date. Pricing changes can happen sooner, so confirm the official source for any purchase decision."],
];
---

<Base title="FAQ | Awesome Coding Plans" description="Answers about AI coding plan pricing, free tiers, quotas, updates, and the machine-readable catalog.">
  <section class="faq-page reveal">
    <p class="eyebrow">05 / reference</p>
    <h1>Frequently asked<br /><span>questions.</span></h1>
    <p class="lede">Short answers about how to read the catalog and use its data responsibly.</p>
    <div class="questions">{questions.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: questions.map(([name, text]) => ({ "@type": "Question", name, acceptedAnswer: { "@type": "Answer", text } })) })}></script>
</Base>

<style>
  .faq-page { max-width: 820px; padding: 4rem 0; } h1 { font-size: clamp(3rem, 8vw, 6rem); line-height: .95; letter-spacing: -.07em; margin: 0 0 1.5rem; } h1 span { color: var(--accent); } .lede { font-size: 1.1rem; max-width: 600px; } .questions { margin-top: 3rem; border-top: 1px solid var(--border); } details { border-bottom: 1px solid var(--border); padding: 1.2rem 0; } summary { cursor: pointer; font-size: 1.05rem; font-weight: 600; } details p { max-width: 650px; margin: .8rem 0 0; }
</style>
