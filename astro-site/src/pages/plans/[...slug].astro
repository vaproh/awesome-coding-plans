---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const plans = await getCollection("plans");
  return plans.map((plan) => ({
    params: { slug: plan.slug },
    props: { plan },
  }));
}

const { plan } = Astro.props;
const { Content } = await render(plan);
---

<Base title={`${plan.data.title} | Awesome Coding Plans`}>
  <div slot="sidebar">
    <a href="/">Home</a>
    <a href="/comparison">Comparison</a>
    <a href="/student-discounts">Student Discounts</a>
    <div class="section-title">All Plans</div>
    {
      (await getCollection("plans")).map((p) => (
        <a href={`/plans/${p.slug}`} class={p.slug === plan.slug ? "active" : ""}>
          {p.data.title}
        </a>
      ))
    }
  </div>

  <article>
    <Content />
    <p>
      <strong>Website:</strong>{" "}
      <a href={plan.data.website} target="_blank" rel="noopener noreferrer">
        {plan.data.website}
      </a>
    </p>
  </article>
</Base>
