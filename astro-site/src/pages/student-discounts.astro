---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const plans = await getCollection("plans");
---

<Base>
  <div slot="sidebar">
    <a href="/">Home</a>
    <a href="/comparison">Comparison</a>
    <a href="/student-discounts" class="active">Student Discounts</a>
    <div class="section-title">All Plans</div>
    {
      plans.map((plan) => (
        <a href={`/plans/${plan.slug}`}>{plan.data.title}</a>
      ))
    }
  </div>

  <div class="hero">
    <h1>Student Discounts &amp; Freebies</h1>
    <p>Student discounts and free tiers specifically for AI coding plans. Verified students can save significantly.</p>
  </div>

  <h2>Quick Cheat Sheet</h2>
  <div class="card-grid stagger">
    <div class="card">
      <h3>Claude for Education</h3>
      <p><span class="badge badge-free">Free Pro</span></p>
      <p>Free Claude Pro + Claude Code at partner universities. Sign in with university email.</p>
    </div>
    <div class="card">
      <h3>GitHub Copilot</h3>
      <p><span class="badge badge-free">Free</span></p>
      <p>Free for verified students. New sign-ups paused since April 2026 — existing users keep it.</p>
    </div>
    <div class="card">
      <h3>Google AI Pro</h3>
      <p><span class="badge badge-free">Free 1yr</span></p>
      <p>Free for US college students. Includes Gemini 3, Antigravity, 5TB storage.</p>
    </div>
    <div class="card">
      <h3>ChatGPT Plus</h3>
      <p><span class="badge badge-free">Free 4mo</span></p>
      <p>4 months free for eligible US college students. Claim by October 31.</p>
    </div>
    <div class="card">
      <h3>Kiro Students</h3>
      <p><span class="badge badge-free">Free 1yr</span></p>
      <p>1,000 credits/month free at 11 partner universities (US/Canada). No credit card.</p>
    </div>
    <div class="card">
      <h3>Perplexity</h3>
      <p><span class="badge badge-paid">$10/mo</span></p>
      <p>50% off Education Pro. Or free via referrals (up to 24 months).</p>
    </div>
    <div class="card">
      <h3>Cursor</h3>
      <p><span class="badge badge-discontinued">Discontinued</span></p>
      <p>Student discount ended June 2026. Hobby plan remains free.</p>
    </div>
    <div class="card">
      <h3>Windsurf</h3>
      <p><span class="badge badge-free">Free plan</span></p>
      <p>No dedicated student discount. Standard Free plan available to everyone.</p>
    </div>
  </div>

  <h2>Details</h2>

  <h3>Claude for Education</h3>
  <p>Free Claude Pro (includes Claude Code) at partner universities including Northeastern, LSE, Champlain College, USF Law, and Northumbria University.</p>
  <table>
    <thead><tr><th>Route</th><th>What You Get</th><th>How</th></tr></thead>
    <tbody>
      <tr><td>Claude for Education</td><td>Free Claude Pro + Claude Code</td><td>Partner university email</td></tr>
      <tr><td>Campus Program</td><td>Free Pro + API credits + stipend</td><td>Apply via claude.com/programs/campus</td></tr>
      <tr><td>Student Builder</td><td>~$50 API credits</td><td>Apply with .edu email</td></tr>
      <tr><td>Annual billing</td><td>$17/mo instead of $20/mo</td><td>No student status needed</td></tr>
    </tbody>
  </table>

  <h3>GitHub Copilot Student</h3>
  <p>Free unlimited completions and AI Credits for verified students. Apply at education.github.com/pack.</p>

  <h3>Google AI Pro for Students</h3>
  <table>
    <thead><tr><th>Region</th><th>What You Get</th><th>Duration</th></tr></thead>
    <tbody>
      <tr><td>US students</td><td>Google AI Pro free (Gemini 3, Antigravity)</td><td>1 year</td></tr>
      <tr><td>International</td><td>Google AI Plus free</td><td>1 year</td></tr>
    </tbody>
  </table>

  <h3>Kiro Students (AWS)</h3>
  <p>1 year free (1,000 credits/month) at 11 partner universities: Arizona State, Cal Poly SLO, CSU Fullerton, Carnegie Mellon, Georgia Tech, Hampton, NYU, U Chicago, U Toronto, U Waterloo, UT Austin.</p>
</Base>
