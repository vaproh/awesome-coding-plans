---
import Base from "../layouts/Base.astro";
import PlanTable from "../components/PlanTable.astro";
import { getCollection } from "astro:content";

const plans = await getCollection("plans");
const tools = ["ide", "cli", "agent", "api"];
const labels: Record<string, string> = { ide: "IDE / editor plugins", cli: "CLI agents", agent: "Autonomous agents", api: "API / BYO harness" };
const groups = tools
  .map((tool) => ({ tool, plans: plans.filter((plan) => plan.data.bestForTags.includes(tool)).sort((a, b) => a.data.title.localeCompare(b.data.title)) }))
  .filter((group) => group.plans.length > 0);
---

<Base title="AI coding plans by tool | Awesome Coding Plans" description="Which AI coding plans include IDE plugins, CLI agents, autonomous agents, or raw API access.">
  <section class="browse reveal">
    <p class="eyebrow">browse / tools</p>
    <h1>By <span>tool.</span></h1>
    <p class="lede">The same subscription can mean very different surfaces. Grouped by where the plan's AI actually plugs in.</p>
    {groups.map((group) => (
      <section>
        <h2>{labels[group.tool]}</h2>
        <PlanTable plans={group.plans} />
      </section>
    ))}
  </section>
</Base>

<style>
  .browse { max-width: 900px; padding: 4rem 0 2rem; }
  .eyebrow { color: var(--accent); font: 500 .72rem "DM Mono", monospace; letter-spacing: .08em; text-transform: uppercase; margin: 0 0 1rem; }
  h1 { font-size: clamp(3rem, 8vw, 6rem); line-height: .95; letter-spacing: -.07em; margin: 0 0 1.5rem; }
  h1 span { color: var(--accent); }
  .lede { font-size: 1.05rem; max-width: 640px; margin-bottom: 2.5rem; }
  section section { margin-bottom: 3rem; }
  h2 { font-size: 1.4rem; margin: 0 0 1rem; }
  @media (max-width: 650px) { table { display: block; overflow-x: auto; white-space: nowrap; } }
</style>
